{
  "name": "3d-hardware-guides",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "check:circuits": "node scripts/check-circuits.mjs",
    "video:frames": "node scripts/capture-intro-frames.mjs",
    "video:studio": "remotion studio src/video/index.ts --public-dir=video-assets",
    "video:render": "remotion render src/video/index.ts CircuitLabIntro public/video/circuit-lab-intro.mp4 --public-dir=video-assets --crf=31 --x264-preset=slow && remotion still src/video/index.ts CircuitLabIntro public/video/circuit-lab-intro-poster.jpg --public-dir=video-assets --frame=50 --image-format=jpeg --jpeg-quality=85"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
